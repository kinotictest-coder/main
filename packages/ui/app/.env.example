# Copy to .env.local for local development (gitignored).
# Leave everything unset to connect to the page's own origin with the browser session.

# Kinotic server the app connects to
VITE_KINOTIC_HOST=
VITE_KINOTIC_PORT=
VITE_KINOTIC_USE_SSL=true

# An application user created on the Kinotic portal: Application -> Members.
# Without these the browser session cookie is used instead.
VITE_KINOTIC_EMAIL=
VITE_KINOTIC_PASSWORD=
