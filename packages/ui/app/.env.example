# Copy to .env.local for local development (gitignored).
# Leave unset to connect to the page's own origin. Credentials are never read from
# the environment — the app always signs in through its login page, against an
# application user created on the Kinotic portal: Application -> Members.

VITE_KINOTIC_HOST=
VITE_KINOTIC_PORT=
VITE_KINOTIC_USE_SSL=true
